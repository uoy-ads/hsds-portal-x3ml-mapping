                           </instance_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>aocat:has_place_IRI</relationship>
                        <entity>
                           <type>owl:Thing</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="xpath">concat('http://sws.geonames.org/', normalize-space(geonames/text()))</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>aocat:has_country</relationship>
                        <entity>
                           <type>owl:Thing</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="xpath">concat('http://www.wikidata.org/entity/', normalize-space(country/@wikidata))</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">normalize-space(country/text())</arg>
                              <arg name="language" type="constant">en</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
