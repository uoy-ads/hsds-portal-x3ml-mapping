                        <arg name="arg2" type="xpath">concat('point/', normalize-space(lat/text()), '/', normalize-space(lon/text()))</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">concat(normalize-space(lat/text()), ', ', normalize-space(lon/text()))</arg>
