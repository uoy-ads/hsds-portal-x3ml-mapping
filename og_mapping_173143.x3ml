            </path>
            <range>
               <source_node>spatial[normalize-space(place_name/text())]</source_node>
               <target_node>
                  <entity>
                     <type>aocat:AO_Spatial_Region</type>
                     <instance_generator name="PlaceURI-2">
                        <arg name="arg1" type="constant">OG</arg>
                        <arg name="arg2" type="xpath">concat('geonames/', normalize-space(geonames/text()))</arg>
                     </instance_generator>
                     <label_generator name="prefLabel">
                        <arg name="text" type="xpath">normalize-space(place_name/text())</arg>
                        <arg name="language" type="constant">en</arg>
                     </label_generator>
                     <additional>
                        <relationship>aocat:has_place_name</relationship>
                        <entity>
                           <type>xsd:string</type>
