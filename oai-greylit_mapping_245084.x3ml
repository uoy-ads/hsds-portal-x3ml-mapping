   <namespaces>
      <namespace prefix="ariadneplus" uri="https://ariadne-infrastructure.eu/aocat/"/>
      <namespace prefix="lexvo" uri="http://lexvo.org/ontology#"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>//oai:record</source_node>
            <target_node>
               <if>
                  <equals value="greylit">oai:header/oai:setSpec</equals>
               </if>
               <entity>
                  <type>aocat:AO_Individual_Data_Resource</type>
                  <instance_generator name="DataResourceURI-2">
                     <arg name="provider" type="constant">ADS</arg>
                     <arg name="term" type="xpath">oai:header/oai:identifier/text()</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="label" type="constant">Record </arg>
                     <arg name="text" type="xpath">oai:header/oai:identifier/text()</arg>
                     <arg name="language" type="constant">en</arg>
                  </label_generator>
                  <additional>
                     <relationship>aocat:has_original_id</relationship>
                     <entity>
                        <type>http://www.w3.org/2001/XMLSchema#string</type>
                        <instance_info>
                           <constant>oai:metadata/oai_dc:dc/dc:identifier[@xsi:type='original id']</constant>
                        </instance_info>
                        <instance_generator name="Literal">
                           <arg name="text" type="xpath">oai:metadata/oai_dc:dc/dc:identifier[@xsi:type='original id']/text()</arg>
                        </instance_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_landing_page</relationship>
                     <entity>
                        <type>owl:Thing</type>
                        <instance_generator name="URIorUUID">
                           <arg name="text" type="xpath">oai:metadata/oai_dc:dc/dc:identifier[@xsi:type='dcterms:DOI']/text()</arg>
                        </instance_generator>
                        <label_generator name="SimpleLabel">
                           <arg name="label" type="xpath">oai:metadata/oai_dc:dc/dc:identifier[@xsi:type='dcterms:DOI']/text()</arg>
                        </label_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:is_part_of</relationship>
                     <entity>
                        <type>aocat:AO_Collection</type>
                        <instance_info>
                           <constant>https://ariadne-infrastructure.eu/aocat/Collection/ADS/5910411B-ED97-364E-8D28-6024558AA14B</constant>
                        </instance_info>
                        <instance_generator name="URIorUUID">
                           <arg name="text" type="constant">https://ariadne-infrastructure.eu/aocat/Collection/ADS/5910411B-ED97-364E-8D28-6024558AA14B</arg>
                        </instance_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_language</relationship>
                     <entity>
                        <type>aocat:AO_Concept</type>
                        <instance_info>
                           <constant>en</constant>
                        </instance_info>
                        <instance_generator name="LangURI">
                           <arg name="term" type="constant">en</arg>
                        </instance_generator>
                        <label_generator name="prefLabel">
                           <arg name="text" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dc:title</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_title</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>oai:metadata/oai_dc:dc/dc:title</source_node>
               <target_node>
                  <entity>
                     <type>http://www.w3.org/2001/XMLSchema#string</type>
                     <instance_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
