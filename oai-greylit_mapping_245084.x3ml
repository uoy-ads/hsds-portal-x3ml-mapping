                     <instance_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dc:owner</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_owner</relationship>
                  <entity>
                     <type>aocat:AO_Agent</type>
                     <instance_generator name="AgentURI">
                        <arg name="term" type="xpath">text()</arg>
