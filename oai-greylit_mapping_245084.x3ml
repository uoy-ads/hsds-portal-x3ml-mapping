         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dc:publisher</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_publisher</relationship>
                  <entity>
                     <type>aocat:AO_Agent</type>
                     <instance_generator name="AgentURI">
