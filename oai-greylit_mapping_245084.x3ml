               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dc:subject</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <not>
                        <if>
                           <equals value="AO Cat Resource Type">@xsi:type</equals>
                        </if>
                     </not>
                  </if>
                  <relationship>aocat:has_native_subject</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>oai:metadata/oai_dc:dc/dc:subject</source_node>
               <target_node>
                  <entity>
                     <type>aocat:AO_Concept</type>
                     <instance_generator name="ConceptURI-2">
                        <arg name="scheme" type="constant">ADS</arg>
                        <arg name="term" type="xpath">upper-case(text())</arg>
                     </instance_generator>
                     <label_generator name="prefLabel">
                        <arg name="text" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </label_generator>
                     <additional>
                        <relationship>aocat:has_type</relationship>
                        <entity>
                           <type>aocat:AO_Concept</type>
                           <instance_info>
                              <constant>@xsi:type</constant>
                           </instance_info>
                           <instance_generator name="ConceptURI-2">
                              <arg name="scheme" type="constant">ADS</arg>
                              <arg name="term" type="xpath">@xsi:type</arg>
                           </instance_generator>
                           <label_generator name="prefLabel">
                              <arg name="text" type="xpath">@xsi:type</arg>
                              <arg name="language" type="constant">en</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>aocat:has_identifier</relationship>
                        <entity>
                           <type>http://www.w3.org/2001/XMLSchema#string</type>
                           <instance_info>
                              <constant>@uri</constant>
                           </instance_info>
                           <instance_generator name="Literal">
                              <arg name="text" type="xpath">@uri</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dcterms:spatial</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <equals value="dcterms:wiki-countries">@xsi:type</equals>
                  </if>
                  <relationship>aocat:has_spatial_coverage</relationship>
                  <entity>
                     <type>aocat:AO_Spatial_Region</type>
                     <instance_generator name="PlaceURI">
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="label" type="constant">Spatial region </arg>
                        <arg name="text" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
                  <relationship>aocat:has_country</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>oai:metadata/oai_dc:dc/dcterms:spatial</source_node>
               <target_node>
                  <entity>
                     <type>owl:Thing</type>
                     <instance_generator name="URIorUUID">
                        <arg name="text" type="xpath">@xsi:uri</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dc:subject</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <equals value="AO Cat Resource Type">@xsi:type</equals>
                  </if>
                  <relationship>aocat:has_ARIADNE_subject</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>oai:metadata/oai_dc:dc/dc:subject</source_node>
               <target_node>
                  <entity>
                     <type>aocat:AO_Concept</type>
                     <instance_generator name="ConceptURI-2">
                        <arg name="scheme" type="constant">AO_Subject</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="prefLabel">
                        <arg name="text" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dcterms:temporal</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_temporal_coverage</relationship>
                  <entity>
                     <type>aocat:AO_Temporal_Region</type>
                     <instance_generator name="Time-SpanURI">
                        <arg name="term" type="xpath">concat(upper-case(text()), '-', ../dcterms:spatial[@xsi:type='dcterms:wiki-countries']/text())</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </label_generator>
                  </entity>
                  <relationship>aocat:has_native_period</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>oai:metadata/oai_dc:dc/dcterms:temporal</source_node>
               <target_node>
                  <entity>
                     <type>owl:Thing</type>
                     <instance_generator name="ConceptURI-2">
                        <arg name="scheme" type="constant">ADS</arg>
                        <arg name="term" type="xpath">concat(upper-case(text()), '-', ../dcterms:spatial[@xsi:type='dcterms:wiki-countries']/text())</arg>
                     </instance_generator>
                     <label_generator name="prefLabel">
                        <arg name="label" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dc:identifier</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <equals value="OBIB">@xsi:type</equals>
                  </if>
                  <relationship>aocat:has_identifier</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>oai:metadata/oai_dc:dc/dc:identifier</source_node>
               <target_node>
                  <entity>
                     <type>http://www.w3.org/2001/XMLSchema#string</type>
                     <instance_generator name="CompositeLabel">
                        <arg name="label" type="xpath">@xsi:type</arg>
                        <arg name="text" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>oai:metadata/oai_dc:dc/dcterms:spatial</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <not>
                        <if>
                           <exists>@xsi:type</exists>
                        </if>
                     </not>
                  </if>
                  <relationship>aocat:has_spatial_coverage</relationship>
                  <entity>
                     <type>aocat:AO_Spatial_Region</type>
                     <instance_generator name="PlaceURI">
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
