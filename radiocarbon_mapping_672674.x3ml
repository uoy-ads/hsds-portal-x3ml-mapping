   <info>
      <title>ARIADNE ads::4</title>
      <general_description>(AO_CAT v1.1.9) Uses the paired subject/period input. Temporal mapping is according to new input files produced by Ceri Binding</general_description>
      <source>
         <source_info>
            <source_schema schema_file="ariadne_4_2025_w_country_sample.xml"
                           type="xml"
                           version="">ariadne_4_2025_w_country_sample</source_schema>
            <namespaces>
               <namespace prefix="dcterms" uri="http://purl.org/dc/terms/"/>
               <namespace prefix="dc" uri="http://purl.org/dc/elements/1.1/"/>
               <namespace prefix="xsi" uri="http://www.w3.org/2001/XMLSchema-instance"/>
            </namespaces>
         </source_info>
      </source>
      <target>
         <target_info>
            <target_schema schema_file="cidoc_crm_v6.2.1-2018April.rdfs"
                           type="rdfs"
                           version="">cidoc_crm_v6.2.1-2018April</target_schema>
            <namespaces>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
            </namespaces>
         </target_info>
         <target_info>
            <target_schema schema_file="AO-CAT (2).rdfs" type="rdfs" version="">AO-CAT (2)</target_schema>
            <namespaces>
               <namespace prefix="aocat"
                          uri="https://www.ariadne-infrastructure.eu/resource/ao/cat/1.1/"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="skos" uri="http://www.w3.org/2004/02/skos/core#"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="crmpe" uri="http://parthenos.d4science.org/CRMext/CRMpe/"/>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
               <namespace prefix="base"
                          uri="https://www.ariadne-infrastructure.eu/resource/ao/cat/1.1/"/>
            </namespaces>
         </target_info>
      </target>
      <mapping_info>
         <mapping_created_by_org/>
         <mapping_created_by_person/>
         <in_collaboration_with/>
      </mapping_info>
      <example_data_info>
