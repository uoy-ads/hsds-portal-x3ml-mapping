                           </instance_info>
                           <instance_generator name="TypedLiteralGen">
                              <arg name="text" type="xpath">../maxYear/text()</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>aocat:has_native_period</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>dcterms:temporal</source_node>
               <target_node>
                  <entity>
                     <type>aocat:AO_Concept</type>
                     <instance_generator name="ConceptURI-2">
                        <arg name="scheme" type="constant">ADS</arg>
                        <arg name="term" type="xpath">upper-case(text())</arg>
