                        <arg name="text" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>country_qid</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_spatial_coverage</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>country_qid</source_node>
               <target_node>
                  <entity>
                     <type>aocat:AO_Spatial_Region</type>
                     <instance_generator name="UUID"/>
                     <additional>
                        <relationship>aocat:has_country</relationship>
                        <entity>
                           <type>owl:Thing</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="xpath">concat("http://www.wikidata.org/entity/",text())</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">../country_label/text()</arg>
                              <arg name="language" type="constant">en</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
      </mapping>
