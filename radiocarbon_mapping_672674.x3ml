   <namespaces>
      <namespace prefix="ariadneplus" uri="https://ariadne-infrastructure.eu/aocat/"/>
      <namespace prefix="lexvo" uri="http://lexvo.org/id/iso639-2/"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>//record</source_node>
            <target_node>
               <if>
                  <equals value="record">@type</equals>
               </if>
               <entity>
                  <type>aocat:AO_Individual_Data_Resource</type>
                  <instance_generator name="DataResourceURI-2">
                     <arg name="provider" type="constant">ADS</arg>
                     <arg name="term" type="xpath">dc:source/text()</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="label" type="constant">Record</arg>
                     <arg name="text" type="xpath">dc:title/text()</arg>
                  </label_generator>
                  <additional>
                     <relationship>aocat:has_original_id</relationship>
                     <entity>
                        <type>http://www.w3.org/2001/XMLSchema#string</type>
                        <instance_info>
                           <constant>substring-after(dc:source/text(), "https://archaeologydataservice.ac.uk/archsearch/record?titleId=")</constant>
                        </instance_info>
                        <instance_generator name="Literal">
                           <arg name="text" type="xpath">substring-after(dc:source/text(), "https://archaeologydataservice.ac.uk/archsearch/record?titleId=")</arg>
                        </instance_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:is_part_of</relationship>
                     <entity>
                        <type>aocat:AO_Collection</type>
                        <instance_info>
                           <constant>https://ariadne-infrastructure.eu/aocat/Collection/ADS/2B68BB7A-60F1-3768-B46E-C80F8423601B</constant>
                        </instance_info>
                        <instance_generator name="URIorUUID">
                           <arg name="text" type="constant">https://ariadne-infrastructure.eu/aocat/Collection/ADS/2B68BB7A-60F1-3768-B46E-C80F8423601B</arg>
                        </instance_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_type</relationship>
                     <entity>
                        <type>aocat:AO_Concept</type>
                        <instance_info>
                           <constant>provided record</constant>
                        </instance_info>
                        <instance_generator name="ConceptURI-2">
                           <arg name="scheme" type="constant">AO_Type</arg>
                           <arg name="term" type="constant">provided record</arg>
                        </instance_generator>
                        <label_generator name="prefLabel">
                           <arg name="text" type="constant">provided record</arg>
                           <arg name="language" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>dc:subjectPeriod</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:is_about</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>dc:subjectPeriod</source_node>
               <target_node>
                  <entity>
                     <type>aocat:AO_Object</type>
                     <instance_generator name="ObjectURI">
                        <arg name="term" type="xpath">dc:subject/text()</arg>
                        <arg name="resource" type="xpath">../dc:source/text()</arg>
                     </instance_generator>
                     <label_generator name="ObjectLabel">
                        <arg name="resource" type="xpath">../dc:source/text()</arg>
                        <arg name="term" type="xpath">dc:subject/text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>dcterms:temporal</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_time_interval</relationship>
                  <entity>
                     <type>aocat:AO_Temporal_Region</type>
                     <instance_generator name="Time-SpanURI">
                        <arg name="term" type="xpath">upper-case(text())</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="label" type="constant">Temporal  region</arg>
                        <arg name="text" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>aocat:from</relationship>
                        <entity>
                           <type>http://www.w3.org/2001/XMLSchema#dateTime</type>
                           <instance_info>
                              <constant>minYear</constant>
                           </instance_info>
                           <instance_generator name="TypedLiteralGen">
                              <arg name="text" type="xpath">../minYear/text()</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>aocat:until</relationship>
                        <entity>
                           <type>http://www.w3.org/2001/XMLSchema#dateTime</type>
                           <instance_info>
                              <constant>maxYear</constant>
                           </instance_info>
                           <instance_generator name="TypedLiteralGen">
                              <arg name="text" type="xpath">../maxYear/text()</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>aocat:has_native_period</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>dcterms:temporal</source_node>
               <target_node>
                  <entity>
                     <type>aocat:AO_Concept</type>
                     <instance_generator name="ConceptURI-2">
                        <arg name="scheme" type="constant">ADS</arg>
                        <arg name="term" type="xpath">upper-case(text())</arg>
                     </instance_generator>
                     <label_generator name="prefLabel">
                        <arg name="text" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>dc:identifier</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_identifier</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>dc:identifier</source_node>
               <target_node>
                  <entity>
                     <type>http://www.w3.org/2001/XMLSchema#string</type>
                     <instance_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>dc:title</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_title</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>dc:title</source_node>
               <target_node>
                  <entity>
                     <type>http://www.w3.org/2001/XMLSchema#string</type>
                     <instance_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                        <arg name="language" type="constant">en</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>dc:creator</relation>
               </source_relation>
               <target_relation>
                  <relationship>aocat:has_creator</relationship>
                  <entity>
                     <type>aocat:AO_Agent</type>
                     <instance_generator name="AgentURI">
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
