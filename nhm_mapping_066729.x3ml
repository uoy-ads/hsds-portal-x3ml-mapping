   <mappings>
      <mapping>
         <domain>
            <source_node>//resource</source_node>
            <target_node>
               <entity>
                  <type>aocat:AO_Collection</type>
                  <instance_generator name="CollectionURI-2">
                     <arg name="provider" type="constant">NHM</arg>
                     <arg name="term" type="xpath">title/text()</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="label" type="constant">Collection</arg>
                     <arg name="text" type="xpath">title/text()</arg>
                     <arg name="language" type="constant">en</arg>
                  </label_generator>
                  <additional>
                     <relationship>aocat:has_publisher</relationship>
                     <entity>
                        <type>aocat:AO_Agent</type>
                        <instance_info>
                           <constant>Heritage Science Data Service</constant>
                        </instance_info>
                        <instance_generator name="AgentURI">
                           <arg name="term" type="constant">Natural History Museum</arg>
                        </instance_generator>
                        <label_generator name="SimpleLabel">
                           <arg name="label" type="constant">Natural History Museum</arg>
                           <arg name="language" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_contributor</relationship>
                     <entity>
                        <type>aocat:AO_Agent</type>
                        <instance_generator name="AgentURI">
                           <arg name="term" type="constant">Heritage Science Data Service</arg>
                        </instance_generator>
                        <label_generator name="SimpleLabel">
                           <arg name="label" type="constant">Heritage Science Data Service</arg>
                           <arg name="language" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_language</relationship>
                     <entity>
                        <type>aocat:AO_Concept</type>
                        <instance_generator name="LangURI">
                           <arg name="term" type="constant">en</arg>
                        </instance_generator>
                        <label_generator name="prefLabel">
                           <arg name="text" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_type</relationship>
                     <entity>
                        <type>aocat:AO_Concept</type>
                        <instance_info>
                           <language>en</language>
                           <constant>collection</constant>
                        </instance_info>
                        <instance_generator name="ConceptURI-2">
                           <arg name="scheme" type="constant">AO_Type</arg>
                           <arg name="term" type="constant">collection</arg>
                        </instance_generator>
                        <label_generator name="prefLabel">
                           <arg name="text" type="constant">collection</arg>
                           <arg name="language" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_ARIADNE_subject</relationship>
                     <entity>
                        <type>aocat:AO_Concept</type>
                        <instance_info>
                           <constant>Scientific analysis</constant>
                        </instance_info>
                        <instance_generator name="ConceptURI-2">
                           <arg name="scheme" type="constant">AO_Subject</arg>
                           <arg name="term" type="constant">Scientific analysis</arg>
                        </instance_generator>
                        <label_generator name="prefLabel">
                           <arg name="text" type="constant">Scientific analysis</arg>
                           <arg name="language" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_responsible</relationship>
                     <entity>
                        <type>aocat:AO_Agent</type>
                        <instance_info>
                           <constant>Natural History Museum</constant>
                        </instance_info>
                        <instance_generator name="AgentURI">
                           <arg name="term" type="constant">Natural History Museum</arg>
                        </instance_generator>
                        <label_generator name="SimpleLabel">
                           <arg name="label" type="constant">Natural History Museum</arg>
                           <arg name="language" type="constant">en</arg>
                        </label_generator>
                     </entity>
                  </additional>
                  <additional>
                     <relationship>aocat:has_access_policy</relationship>
                     <entity>
                        <type>owl:Thing</type>
                        <instance_generator name="URIorUUID">
